    {"id": 2, "type": "graph", "title": "Reconciler loop p95 duration", "datasource": "Mimir", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (loop, le) (rate(kacho_compute_reconciler_loop_seconds_bucket[5m])))"}]},
    {"id": 3, "type": "graph", "title": "Disk attach/detach rate", "datasource": "Mimir", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by (action) (rate(kacho_compute_disk_attach_total[5m]))"}]}
  ],
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "30s"
