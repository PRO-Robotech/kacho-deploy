{
  "title": "Kachō IAM — SLO Burn Rate",
  "uid": "iam-slo-burn-rate",
  "tags": ["kacho", "iam", "slo"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Auth availability — 30d budget consumed",
      "datasource": "Mimir",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [{"expr": "1 - slo:availability:ratio_rate30d{slo_name=\"auth-availability\"}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1.0}]}}}
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Burn rate (5m / 1h / 6h / 1d / 3d windows)",
      "datasource": "Mimir",
      "gridPos": {"x": 6, "y": 0, "w": 18, "h": 8},
      "targets": [
        {"expr": "slo:current_burn_rate:ratio_rate5m{slo_name=\"auth-availability\"}", "legendFormat": "5m"},
        {"expr": "slo:current_burn_rate:ratio_rate1h{slo_name=\"auth-availability\"}", "legendFormat": "1h"},
        {"expr": "slo:current_burn_rate:ratio_rate6h{slo_name=\"auth-availability\"}", "legendFormat": "6h"},
        {"expr": "slo:current_burn_rate:ratio_rate1d{slo_name=\"auth-availability\"}", "legendFormat": "1d"},
        {"expr": "slo:current_burn_rate:ratio_rate3d{slo_name=\"auth-availability\"}", "legendFormat": "3d"}
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "All SLOs status",
      "datasource": "Mimir",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "targets": [{"expr": "slo:current_burn_rate:ratio_rate1h"}],
      "transformations": [{"id": "organize", "options": {"renameByName": {"slo_name": "SLO", "slo_objective": "Target", "Value": "Burn rate (1h)"}}}]
    }
  ],
  "time": {"from": "now-7d", "to": "now"},
  "refresh": "1m"
}
