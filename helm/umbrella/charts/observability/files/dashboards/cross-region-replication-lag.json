{
  "title": "Kachō — Cross-region Replication Lag",
  "uid": "cross-region-replication-lag",
  "tags": ["kacho", "replication", "multi-region"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"id": 1, "type": "graph", "title": "Postgres streaming replication lag (bytes)", "datasource": "Mimir", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "pg_stat_replication_pg_wal_lsn_diff_bytes"}]},
    {"id": 2, "type": "graph", "title": "Kafka MirrorMaker 2 replication lag (ms)", "datasource": "Mimir", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "mm2_replication_lag_ms"}]},
    {"id": 3, "type": "graph", "title": "ClickHouse Replicated max absolute delay (s)", "datasource": "Mimir", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "chr_replica_max_absolute_delay"}]},
    {"id": 4, "type": "stat", "title": "OpenFGA consistency token age (eu-west)", "datasource": "Mimir", "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4}, "targets": [{"expr": "time() - max(openfga_replica_consistency_token_observed_timestamp_seconds{region=\"prod-eu-west\"})"}], "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 30}, {"color": "red", "value": 60}]}}}}
  ],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s"
}
