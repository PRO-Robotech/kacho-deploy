{
  "title": "Kachō IAM — CAEP Push Pipeline",
  "uid": "iam-caep-pipeline",
  "tags": ["kacho", "iam", "caep"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"id": 1, "type": "graph", "title": "CAEP events emitted per minute", "datasource": "Mimir", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (event_type) (rate(kacho_iam_caep_events_emitted_total[1m]))"}]},
    {"id": 2, "type": "graph", "title": "Delivery latency p99 per subscriber", "datasource": "Mimir", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.99, sum by (subscriber, le) (rate(kacho_iam_caep_delivery_seconds_bucket[5m])))"}]},
    {"id": 3, "type": "graph", "title": "Webhook retry queue depth", "datasource": "Mimir", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "kacho_iam_caep_retry_queue_depth"}]},
    {"id": 4, "type": "graph", "title": "Subscriber failures per hour", "datasource": "Mimir", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by (subscriber) (increase(kacho_iam_caep_delivery_failures_total[1h]))"}]}
  ],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s"
}
