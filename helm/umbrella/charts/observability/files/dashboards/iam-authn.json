    {"id": 2, "type": "graph", "title": "WebAuthn registration vs assertion rate", "datasource": "Mimir", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(kratos_webauthn_registrations_total[5m]))", "legendFormat": "registered"}, {"expr": "sum(rate(kratos_webauthn_assertions_total[5m]))", "legendFormat": "asserted"}]},
    {"id": 3, "type": "graph", "title": "Hydra token issuance p95 latency", "datasource": "Mimir", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(hydra_token_request_duration_seconds_bucket[5m])))"}]},
    {"id": 4, "type": "graph", "title": "DPoP-bound vs bearer tokens issued", "datasource": "Mimir", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by (binding_type) (rate(hydra_tokens_issued_total[5m]))"}]}
