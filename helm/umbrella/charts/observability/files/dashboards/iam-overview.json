{
  "title": "Kachō IAM — Overview",
  "uid": "iam-overview",
  "tags": ["kacho", "iam"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "AuthN success rate (5m)",
      "datasource": "Mimir",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {"expr": "1 - (sum(rate(kacho_iam_authn_failures_total[5m])) / sum(rate(kacho_iam_authn_attempts_total[5m])))"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 0.995}, {"color": "green", "value": 0.999}]}}}
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Token issuance rate (1m)",
      "datasource": "Mimir",
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 8},
      "targets": [{"expr": "sum by (kacho_cloud_region) (rate(kacho_iam_token_issued_total[1m]))"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "FGA Check p95 (5m)",
      "datasource": "Mimir",
      "gridPos": {"x": 15, "y": 0, "w": 4, "h": 4},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(kacho_iam_authz_check_duration_seconds_bucket[5m])))"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 0.015}, {"color": "red", "value": 0.020}]}}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JWKS rotation age",
      "datasource": "Mimir",
      "gridPos": {"x": 19, "y": 0, "w": 5, "h": 4},
      "targets": [{"expr": "(time() - max(kacho_iam_jwks_current_key_created_timestamp_seconds))"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 5184000}, {"color": "red", "value": 7776000}]}}}
    },
    {
      "id": 5,
      "type": "graph",
      "title": "Tokens issued vs revoked",
      "datasource": "Mimir",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(kacho_iam_token_issued_total[5m]))", "legendFormat": "issued"},
        {"expr": "sum(rate(kacho_iam_token_revoked_total[5m]))", "legendFormat": "revoked"}
      ]
    }
  ],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s"
}
