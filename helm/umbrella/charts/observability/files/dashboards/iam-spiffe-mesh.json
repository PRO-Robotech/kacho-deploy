{
  "title": "Kachō — SPIFFE / SPIRE / Cilium Mesh",
  "uid": "iam-spiffe-mesh",
  "tags": ["kacho", "spiffe", "spire", "cilium"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {"id": 1, "type": "graph", "title": "SVID issuance rate", "datasource": "Mimir", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum by (trust_domain) (rate(spire_server_svid_issued_total[5m]))"}]},
    {"id": 2, "type": "graph", "title": "SVID rotation age (max)", "datasource": "Mimir", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "max by (workload) (time() - spire_agent_svid_rotated_timestamp_seconds)"}]},
    {"id": 3, "type": "graph", "title": "Cilium mTLS handshake failures", "datasource": "Mimir", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(cilium_mtls_handshake_failures_total[5m]))"}]},
    {"id": 4, "type": "graph", "title": "Hubble policy drops (last 5m)", "datasource": "Mimir", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by (reason) (rate(hubble_drop_total[5m]))"}]}
  ],
  "time": {"from": "now-3h", "to": "now"},
  "refresh": "30s"
}
